{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genesis-import.example/contracts/adyen-inbound-message-v1.schema.json",
  "title": "Adyen inbound message v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transportId", "logicalEventKey", "source", "messageType", "occurredAtUtc",
    "receivedAtUtc", "payloadHash", "merchantAccount", "environment", "pspReference",
    "successProvided", "currencyCode", "amount"
  ],
  "properties": {
    "transportId": { "$ref": "#/$defs/sha256" },
    "logicalEventKey": { "type": "string", "minLength": 1, "maxLength": 250 },
    "source": { "enum": ["Webhook", "Report"] },
    "messageType": { "type": "string", "minLength": 1, "maxLength": 50 },
    "occurredAtUtc": { "type": "string", "format": "date-time" },
    "receivedAtUtc": { "type": "string", "format": "date-time" },
    "payloadHash": { "$ref": "#/$defs/sha256" },
    "merchantAccount": { "type": "string", "minLength": 1, "maxLength": 80 },
    "environment": { "enum": ["Test", "Live"] },
    "pspReference": { "type": "string", "minLength": 1, "maxLength": 50 },
    "originalPspReference": { "type": "string", "maxLength": 50 },
    "merchantReference": { "type": "string", "maxLength": 80 },
    "shopperReference": { "type": "string", "maxLength": 250 },
    "paymentMethod": { "type": "string", "maxLength": 50 },
    "successProvided": { "type": "boolean" },
    "success": { "type": "boolean" },
    "currencyCode": { "type": "string", "maxLength": 10 },
    "amount": { "type": "number", "minimum": 0 },
    "reportRunId": { "type": "string", "maxLength": 100 },
    "reportRowIdentity": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "const": "" }] },
    "rawArchiveReference": { "type": "string", "maxLength": 2048 }
  },
  "allOf": [
    {
      "if": { "properties": { "successProvided": { "const": true } } },
      "then": { "required": ["success"] }
    },
    {
      "if": { "properties": { "source": { "const": "Report" } } },
      "then": { "required": ["reportRunId", "reportRowIdentity"] }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}

